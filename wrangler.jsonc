{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myclash-sub",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // 存放訂閱組的 KV；部署時會自動建立，不用填 id
  "kv_namespaces": [{ "binding": "SUBS" }],
  // 管理頁：打開 Worker 網址就是管理頁
  "assets": { "directory": "./docs" }
}
