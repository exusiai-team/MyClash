{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myclash",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // 压缩打包结果（154 KiB → 78 KiB），上传更快；不发送 wrangler 使用统计，部署少一次网络请求
  "minify": true,
  "send_metrics": false,
  // 存放订阅组的 KV；部署时会自动创建（名称 myclash-sub-store），不用填 id
  "kv_namespaces": [{ "binding": "SUB_STORE" }],
  // 管理页：打开 Worker 地址就是管理页
  "assets": { "directory": "./public" },
  // 管理页「立即刷新缓存」要触发的 GitHub 仓库；另需在 Cloudflare 把 GITHUB_TOKEN 设为密钥
  "vars": { "GITHUB_REPO": "exusiai-team/MyClash" },
  // Cloudflare 的预览构建（wrangler preview）要求有这个区块；预览版本不绑定 KV，只用来确认能正常构建
  "previews": {}
}
